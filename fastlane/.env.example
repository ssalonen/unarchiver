# Template for local fastlane runs. Copy to fastlane/.env (gitignored, which
# fastlane loads automatically — no --env flag needed) and fill in.
#
#   cp fastlane/.env.example fastlane/.env
#
# On CI these come from GitHub Actions secrets instead (see
# .github/workflows/release.yml); this file exists only so a Mac can run
# `fastlane certificates` the same way.
# NEVER commit fastlane/.env — it holds a private key.

# Apple Developer team (Membership details in the portal).
APPLE_TEAM_ID=KWD389FVBC

# App Store Connect API key. Same values as the repo secrets. The Issuer ID is
# per *team*, not per key: Users and Access → Integrations → Keys, above the
# key list. The .p8 itself is downloadable only once, at key creation.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# The RAW .p8 text, not base64 — matching how the repo secret is stored.
# dotenv needs it on one line, so replace newlines with \n, e.g.:
#   ruby -e 'print File.read(ARGV[0]).gsub("\n", "\\n")' AuthKey_ABC123.p8
# Alternatively leave this blank and `export` it in your shell instead:
#   export APP_STORE_CONNECT_API_KEY_P8="$(cat ~/AuthKey_ABC123.p8)"
APP_STORE_CONNECT_API_KEY_P8=

# match: the shared per-team signing repo — one passphrase encrypts the whole
# repo, so these are the same values as every-byte-counts and keepscrolling.
MATCH_GIT_URL=git@github.com:ssalonen/ios-signing.git
MATCH_PASSWORD=

# The `certificates` lane is readonly only on CI, so a local run may create and
# push missing profiles. That needs write access to the signing repo (your own
# SSH key — the CI deploy key is read-only) and an API key allowed to manage
# profiles. Re-minting after an App-ID capability change additionally needs
# `fastlane match appstore --force`.
